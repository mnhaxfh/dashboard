        </UserObject>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Định nghĩa các làn bằng định dạng màu sắc hoặc phân cụm dọc\n    subgraph L1[\&quot;Bệnh nhân &amp; Lễ tân\&quot;]\n        StartNode(( )) --&gt; A[Bệnh nhân cần khám bệnh]\n        A --&gt; B1[Đăng ký khám qua App di động]\n        A --&gt; B2[Đăng ký khám trực tiếp tại Quầy lễ tân]\n        \n        B1 --&gt; B_Merge[ ]\n        B2 --&gt; B_Merge[ ]\n        style B_Merge fill:none,stroke:none,width:0px\n        \n        I[Nhận thông báo xét nghiệm trên App] --&gt; J1[Xem hướng dẫn bản đồ bằng Chatbot]\n        I --&gt; J2[Xem bản đồ phòng ban Thủ công trên App]\n        \n        J1 --&gt; J_Merge[ ]\n        J2 --&gt; J_Merge[ ]\n        style J_Merge fill:none,stroke:none,width:0px\n        \n        J_Merge --&gt; K[Di chuyển đến phòng xét nghiệm theo bản đồ]\n        K --&gt; L[Thực hiện xét nghiệm &amp; Chờ kết quả]\n        \n        R[Nhận đơn thuốc và kết quả trên App] --&gt; EndNode((( )))\n    end\n\n    subgraph L2[\&quot;Hệ thống / CSDL\&quot;]\n        C[Lưu thông tin đăng ký]\n        D[Cập nhật danh sách chờ]\n        C --&gt; D\n        \n        H[Cập nhật chỉ định xét nghiệm vào CSDL]\n        M[Cập nhật kết quả xét nghiệm vào CSDL]\n        Q[Lưu lịch sử khám bệnh]\n    end\n\n    subgraph L3[\&quot;Bác sĩ (Web)\&quot;]\n        E[Nhận và xem Danh sách bệnh nhân trên Web]\n        F[Gọi bệnh nhân vào phòng khám]\n        G[Tiến hành khám sơ bộ]\n        E --&gt; F --&gt; G\n        \n        Choice{Cần làm xét nghiệm cận lâm sàng?}\n        G --&gt; Choice\n        \n        Choice --&gt;|Có| N1[Chỉ định các xét nghiệm cần thiết]\n        N1 --&gt; N2[Điền thông tin xét nghiệm lên Web]\n        \n        Choice --&gt;|Không| O[Đưa ra chẩn đoán dựa trên khám sơ bộ]\n        \n        P1[Xem kết quả xét nghiệm trên Web] --&gt; P2[Đưa ra chẩn đoán cuối cùng]\n        \n        Merge{ }\n        O --&gt; Merge\n        P2 --&gt; Merge\n        \n        Merge --&gt; P3[Kê đơn thuốc và hoàn thành lượt khám]\n    end\n\n    %% Kết nối liên làn (Cross-lane arrows) dựa theo image_c8cd83.jpg\n    B_Merge --&gt; C\n    D --&gt; E\n    N2 --&gt; H\n    H --&gt; I\n    L --&gt; M\n    M --&gt; P1\n    P3 --&gt; Q\n    Q --&gt; R\n\n    %% Định dạng giao diện giống ảnh mẫu\n    classDef default fill:#FEFECE,stroke:#A2AAAD,stroke-width:1px;\n    classDef lane fill:#fff,stroke:#2C3E50,stroke-width:1px;\n    style L1 fill:#E0F7FA,stroke:#2C3E50\n    style L2 fill:#F5F5F5,stroke:#2C3E50\n    style L3 fill:#E0F2F1,stroke:#2C3E50&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CGEbfp_giAItChUBci0y-71">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="6980" width="2193" as="geometry" />
          </mxCell>
        </UserObject>
